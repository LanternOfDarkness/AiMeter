<Application x:Class="AiMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiMeter"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:viewModels="clr-namespace:AiMeter.ViewModels">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Tray Icon Resource -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="AiMeter"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{Binding ShowWidgetCommand}"
                        DoubleClickCommand="{Binding ShowSettingsCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding AvailableUpdateText}" Command="{Binding ShowUpdateCommand}"
                              Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Separator />
                    <MenuItem Header="Show Widget" Command="{Binding ShowWidgetCommand}" />
                    <MenuItem Header="Settings" Command="{Binding ShowSettingsCommand}" />
                    <MenuItem Header="Check for updates…" Command="{Binding CheckForUpdatesCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
