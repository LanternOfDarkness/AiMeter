<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:AiMeter.Converters">

    <converters:QuotaToColorConverter x:Key="QuotaToColorConverter" />
    <converters:ResetTimeConverter x:Key="ResetTimeConverter" />
    <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter" />
    <converters:MetricLabelConverter x:Key="MetricLabelConverter" />
    <converters:TimeBarFractionConverter x:Key="TimeBarFractionConverter" />
    <converters:MetricBarColorConverter x:Key="MetricBarColorConverter" />
    <converters:FontScaleConverter x:Key="FontScaleConverter" />
    <converters:GapToMarginConverter x:Key="GapToMarginConverter" />
    <converters:PercentageWidthMultiConverter x:Key="PercentageWidthMultiConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Dark-themed to match the widget - WPF's default ToolTip chrome is a light box with
         black text, which reads as a jarring mismatch popping up over an otherwise all-dark
         widget. Applies to every ToolTip in the widget (Compact's plain-string ones too). -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#EE202024" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!-- Taskbar mode: one narrow vertical-fill column per metric, sized to sit at taskbar
         height. Code, remaining percentage, and reset countdown are all always visible (a
         column is only ~28px wide, so a couple of digits per row costs almost nothing) - the
         tooltip's full name and verbose reset text are the only hover-only extras. Both fills
         are plain Borders stretched to the full available height, then visually scaled from
         the bottom via a ScaleTransform - simpler than computing pixel heights against a
         window height that varies with the detected taskbar thickness. -->
    <DataTemplate x:Key="TaskbarMetricColumn">
        <Grid Width="28" Margin="2,0,2,0">
            <Grid.ToolTip>
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} — {1:0}%">
                                <Binding Path="Name" />
                                <Binding Path="RemainingPercentage" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- Money metrics (Claude Extra Usage) add a spend/balance detail line
                         beneath the percent summary - hidden for ordinary quota metrics. -->
                    <TextBlock Text="{Binding TooltipDetail}"
                               Visibility="{Binding IsMoneyMetric, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ResetTimeConverter}">
                                <Binding Path="ResetTime" />
                                <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid.ToolTip>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Name, Converter={StaticResource MetricLabelConverter}}"
                       Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,1"
                       FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScaleConverter}, ConverterParameter=0.72;7;10}" />

            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Track -->
                <Border CornerRadius="2" Background="#33FFFFFF" />

                <!-- Quota fill: bottom-anchored scale, colored by the per-metric override or,
                     failing that, the quota-threshold palette. Hidden for unbounded money
                     metrics (Extra Usage on an "Unlimited" plan) - there's no cap to scale
                     the fill against, so it's spend/balance text only (see below). -->
                <Border CornerRadius="2" RenderTransformOrigin="0.5,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnbounded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource MetricBarColorConverter}">
                            <Binding Path="." />
                            <Binding Path="DataContext.Config.BarColorMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform ScaleY="{Binding RemainingPercentage, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=1}" />
                    </Border.RenderTransform>
                </Border>

                <!-- Time-progress sliver: fills as the reset approaches, hugging the right edge. -->
                <Rectangle Width="2" HorizontalAlignment="Right" Fill="#55FFFFFF" Margin="0,0,1,0"
                           RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform>
                            <ScaleTransform.ScaleY>
                                <MultiBinding Converter="{StaticResource TimeBarFractionConverter}">
                                    <Binding Path="ResetTime" />
                                    <Binding Path="WindowDuration" />
                                    <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </ScaleTransform.ScaleY>
                        </ScaleTransform>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Remaining percentage (or, for money metrics, a rounded value/balance figure -
                     see UsageMetric.ValueTextShort), always visible - sits just under the code
                     label, on top of the fill/track regardless of how full the bar is. -->
                <TextBlock FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                           FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScaleConverter}, ConverterParameter=0.82;8;11}"
                           Visibility="{Binding DataContext.Config.ShowNumericValues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding RemainingPercentage, StringFormat={}{0:0}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMoneyMetric}" Value="True">
                                    <Setter Property="Text" Value="{Binding ValueTextShort}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Reset countdown, always visible - "3.3h"/"5.2d" style keeps it a consistent,
                 narrow width instead of a multi-unit compound like "3h20m". -->
            <TextBlock Grid.Row="2" Foreground="#999999"
                       HorizontalAlignment="Center" Margin="0,1,0,0"
                       FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScaleConverter}, ConverterParameter=0.64;6;9}"
                       Visibility="{Binding DataContext.Config.ShowNumericValues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource ResetTimeConverter}" ConverterParameter="decimal">
                        <Binding Path="ResetTime" />
                        <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- Compact mode's single metric row: label / colored bar / % (or dollar text) / reset.
         Shared by the floating window's Compact layout and Deskband mode (which stacks two of
         these per column before wrapping right, so the taskbar shows Compact-style bars rather
         than Taskbar mode's narrow vertical-fill columns). -->
    <DataTemplate x:Key="CompactMetricRow">
        <!-- Fixed row height (from the configured font size) keeps the column-wrap math exact;
             the margin is horizontal-only so a row's vertical footprint stays exactly its Height. -->
        <Grid Height="{Binding DataContext.CompactRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
              Margin="{Binding DataContext.Config.CompactColumnGap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GapToMarginConverter}, ConverterParameter=Right}">
            <Grid.ToolTip>
                <StackPanel>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} — {1:0}%">
                                <Binding Path="DisplayName" />
                                <Binding Path="RemainingPercentage" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- Money metrics (Claude Extra Usage) add a spend/balance detail line beneath
                         the percent summary - hidden for ordinary quota metrics. -->
                    <TextBlock Text="{Binding TooltipDetail}"
                               Visibility="{Binding IsMoneyMetric, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ResetTimeConverter}">
                                <Binding Path="ResetTime" />
                                <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid.ToolTip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="CompactLabelColumn" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="White"
                       FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <Border Grid.Column="1" Height="6" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Width="{Binding DataContext.Config.BarWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="{Binding DataContext.Config.CompactCellGap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GapToMarginConverter}}">
                <!-- Unbounded money metrics (Extra Usage on an "Unlimited" plan) have no cap to
                     measure a fill against - hide the bar rather than render a misleading
                     always-full or always-empty track. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnbounded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border HorizontalAlignment="Left" CornerRadius="3">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentageWidthMultiConverter}">
                            <Binding Path="RemainingPercentage" />
                            <Binding Path="DataContext.Config.BarWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Border.Width>
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource MetricBarColorConverter}">
                            <Binding Path="." />
                            <Binding Path="DataContext.Config.BarColorMode" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Border.Background>
                </Border>
            </Border>

            <!-- Value column: a bare percentage for ordinary quota metrics, or the formatted
                 dollar text for money metrics like Claude Extra Usage. -->
            <TextBlock Grid.Column="2"
                       Foreground="#CCCCCC" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScaleConverter}, ConverterParameter=0.85}"
                       Margin="{Binding DataContext.Config.CompactCellGap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GapToMarginConverter}}"
                       Visibility="{Binding DataContext.Config.ShowNumericValues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding RemainingPercentage, StringFormat={}{0:0}%}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMoneyMetric}" Value="True">
                                <Setter Property="Text" Value="{Binding ValueText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="3" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="{Binding DataContext.Config.WidgetFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScaleConverter}, ConverterParameter=0.85}"
                       Margin="{Binding DataContext.Config.CompactCellGap, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GapToMarginConverter}}"
                       Visibility="{Binding DataContext.Config.ShowNumericValues, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource ResetTimeConverter}" ConverterParameter="short">
                        <Binding Path="ResetTime" />
                        <Binding Path="DataContext.Now" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
