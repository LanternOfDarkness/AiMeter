<UserControl x:Class="AiMeter.Controls.CircularProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding Size, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <Grid>
        <!-- Background Track -->
        <Path Stroke="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Path.Data>
                <EllipseGeometry x:Name="PART_TrackGeometry" />
            </Path.Data>
        </Path>

        <!-- Foreground Track -->
        <Path Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeEndLineCap="Round"
              StrokeStartLineCap="Round">
            <Path.Data>
                <PathGeometry>
                    <PathFigure x:Name="PART_PathFigure" StartPoint="0,0">
                        <ArcSegment x:Name="PART_ArcSegment" SweepDirection="Clockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
        
        <!-- Center Text: value + "%" as Runs in one TextBlock (a StackPanel would shift the
             visual center between the two differently-sized runs). LineStackingStrategy +
             LineHeight pinned to FontSize compensates for the font's internal leading, which
             otherwise pushes vertically-centered text visibly above true center. -->
        <TextBlock Foreground="White"
                   FontWeight="SemiBold"
                   FontSize="16"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="0"
                   Margin="0,1,0,0"
                   LineStackingStrategy="BlockLineHeight"
                   LineHeight="16"><Run Text="{Binding ValueText, RelativeSource={RelativeSource AncestorType=UserControl}}" /><Run Text="%" FontSize="10" FontWeight="Normal" /></TextBlock>
    </Grid>
</UserControl>
