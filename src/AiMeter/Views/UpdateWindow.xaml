<Window x:Class="AiMeter.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AiMeter Update" Height="440" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/app.ico"
        Background="#1C1C1E">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#2ECC71" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Height" Value="32" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="#5B5B5B" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Height" Value="32" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AiMeter Update" Foreground="White" FontSize="18" FontWeight="Bold" />

        <TextBlock Grid.Row="1" Text="{Binding VersionTransitionText}" Foreground="#CCCCCC" FontSize="13" Margin="0,4,0,14" />

        <Border Grid.Row="2" Style="{StaticResource SectionCard}" VerticalAlignment="Stretch">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="RELEASE NOTES" Style="{StaticResource SectionHeader}" />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Notes}" Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />

            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1"
                         Value="{Binding DownloadFraction, Mode=OneWay}"
                         Background="#2E2E30" Foreground="#2ECC71" BorderThickness="0"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="IsIndeterminate" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressDeterminate}" Value="True">
                                <Setter Property="IsIndeterminate" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Text="{Binding LastError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding InstallUnavailableReason}" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallUnavailableReason}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Download &amp; install" Command="{Binding DownloadAndInstallCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Retry" Command="{Binding DownloadAndInstallCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Open release page" Command="{Binding OpenReleasePageCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowReleasePageButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Later" Command="{Binding LaterCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Content="Skip this version" Command="{Binding SkipVersionCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowSkipButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Release notes on GitHub" Command="{Binding OpenReleasePageCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReleasePageUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>
    </Grid>
</Window>
