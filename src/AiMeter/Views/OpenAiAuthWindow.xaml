<Window x:Class="AiMeter.Views.OpenAiAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenAI API Key" Height="260" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#202020">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#EEEEEE" FontSize="14" FontWeight="SemiBold"
                   Text="Enter your OpenAI Platform API key" Margin="0,0,0,10" />

        <PasswordBox x:Name="keyBox" Grid.Row="1" Height="30" FontSize="13" Padding="6,4"
                     Background="#2D2D2D" Foreground="#EEEEEE" BorderBrush="#3F3F3F" />

        <TextBlock Grid.Row="2" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Use a user or admin key with billing read access (project keys can't read billing). The key is encrypted with Windows DPAPI and stored only on this PC — it never leaves your machine except in requests to api.openai.com." />

        <TextBlock x:Name="errorText" Grid.Row="3" Foreground="#E74C3C" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Visibility="Collapsed" Margin="0,10,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="cancelButton" Content="Cancel" Width="90" Height="30" Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button x:Name="saveButton" Content="Save" Width="90" Height="30" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
